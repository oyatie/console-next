  "liveBrowserJobs": [
    {"job": "Build browser test application", "steps": ["E2E policy and workflow controls", "Build the full E2E backend once", "Build the served web client once", "Refuse an empty live suite", "Check cross-browser inventory", "Plan Firefox mocked states"]},
