{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: LicenseRef-Proprietary",
  "type": "object",
  "required": [
    "sources",
    "access",
    "origin",
    "thresholds",
    "budgets"
  ],
  "properties": {
    "sources": {
      "type": "object",
      "required": [
        "alertmanager",
        "vmalert",
        "victoriametrics"
      ],
      "properties": {
        "alertmanager": {
          "type": "object",
          "required": [
            "url",
            "producer",
            "interval_s",
            "read_limits"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "producer": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!(?:No data|N/A|—)$).+"
            },
            "interval_s": {
              "type": "integer",
              "minimum": 1
            },
            "read_limits": {
              "type": "object",
              "required": [
                "request_timeout_ms",
                "max_response_bytes"
              ],
              "properties": {
                "request_timeout_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_response_bytes": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false,
              "description": "Request deadline must be shorter than interval_s; validated by the source adapter."
            }
          },
          "additionalProperties": false
        },
        "vmalert": {
          "type": "object",
          "required": [
            "url",
            "producer",
            "interval_s",
            "read_limits"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "producer": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!(?:No data|N/A|—)$).+"
            },
            "interval_s": {
              "type": "integer",
              "minimum": 1
            },
            "read_limits": {
              "type": "object",
              "required": [
                "request_timeout_ms",
                "max_response_bytes"
              ],
              "properties": {
                "request_timeout_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_response_bytes": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false,
              "description": "Request deadline must be shorter than interval_s; validated by the source adapter."
            }
          },
          "additionalProperties": false
        },
        "victoriametrics": {
          "type": "object",
          "required": [
            "url",
            "producer",
            "interval_s",
            "read_limits"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "producer": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!(?:No data|N/A|—)$).+"
            },
            "interval_s": {
              "type": "integer",
              "minimum": 1
            },
            "read_limits": {
              "type": "object",
              "required": [
                "request_timeout_ms",
                "max_response_bytes"
              ],
              "properties": {
                "request_timeout_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_response_bytes": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false,
              "description": "Request deadline must be shorter than interval_s; validated by the source adapter."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "required": [
        "team",
        "aud",
        "issuer",
        "jwks",
        "interval_s"
      ],
      "properties": {
        "team": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!(?:No data|N/A|—)$).+"
        },
        "aud": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!(?:No data|N/A|—)$).+"
        },
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "jwks": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:/[^/]|https?://)"
        },
        "interval_s": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "origin": {
      "type": "string",
      "pattern": "^https?://[^/?#]+$"
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "additionalProperties": false
}
