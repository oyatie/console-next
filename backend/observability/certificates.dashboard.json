{
  "title": "HR certificates",
  "uid": "hr-certificates",
  "schemaVersion": 39,
  "tags": [
    "hr",
    "certificates"
  ],
  "description": "SPDX-License-Identifier: LicenseRef-Proprietary. Certificate route RED metrics; no employee identifiers in labels.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, method) (rate(hr_certificate_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Server errors per second",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(hr_certificate_requests_total{status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request duration p95",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,route) (rate(hr_certificate_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ]
    }
  ]
}
